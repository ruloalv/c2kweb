---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { clientes } from '../data/clientes';
import TituloSeccion from './TituloSeccion.astro';

const archivos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/clientes/*.{png,jpg,jpeg,webp}',
  { eager: true }
);
const logo = (nombre: string) => archivos[`../assets/clientes/${nombre}`]?.default;

const grupos = ['Vialidad', 'Municipios', 'Privados'] as const;
---

<section id="clientes" class="bg-asfalto-50 py-20 dark:bg-asfalto-900 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <TituloSeccion
      etiqueta="Confían en nosotros"
      titulo="Clientes"
      bajada="Vialidad Nacional y provinciales, más de veinte municipios y empresas constructoras de primera línea."
      centrado
    />

    <div class="mt-14 space-y-12">
      {
        grupos.map((g) => (
          <div>
            <h3 class="mb-5 text-center text-sm font-bold uppercase tracking-widest text-asfalto-600 dark:text-asfalto-300">
              {g}
            </h3>
            <ul class="grid grid-cols-3 gap-3 sm:grid-cols-4 lg:grid-cols-6">
              {clientes
                .filter((c) => c.grupo === g)
                .map((c) => {
                  const img = logo(c.logo);
                  const Etiqueta = c.link ? 'a' : 'div';
                  return (
                    <li>
                      <Etiqueta
                        href={c.link}
                        target={c.link ? '_blank' : undefined}
                        rel={c.link ? 'noopener' : undefined}
                        class="flex h-24 items-center justify-center rounded-xl border border-asfalto-100 bg-white p-3 transition hover:border-asfalto-300 hover:shadow-sm dark:border-white/10 dark:bg-white"
                        title={c.nombre}
                      >
                        <span class="sr-only">{c.nombre}{c.link ? ' (sitio externo)' : ''}</span>
                        {img ? (
                          <Image
                            src={img}
                            alt={c.nombre}
                            widths={[160, 320]}
                            sizes="160px"
                            loading="lazy"
                            class="logo-cliente max-h-14 w-auto object-contain"
                          />
                        ) : (
                          <span class="text-center text-sm font-semibold text-asfalto-900">{c.nombre}</span>
                        )}
                      </Etiqueta>
                    </li>
                  );
                })}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
