---
import { empresa } from '../config/empresa';
import { ruta } from '../config/rutas';

const links = [
  { href: ruta('/') + '#empresa', texto: 'Empresa' },
  { href: ruta('/') + '#productos', texto: 'Productos' },
  { href: ruta('/') + '#obras', texto: 'Obras' },
  { href: ruta('/') + '#clientes', texto: 'Clientes' },
  { href: ruta('/vecinos'), texto: 'Vecinos' },
  { href: ruta('/') + '#contacto', texto: 'Contacto' },
];
---

<header class="sticky top-0 z-50 border-b-2 border-amarillo bg-asfalto-950/95 text-white backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href={ruta('/')} class="flex shrink-0 items-center" aria-label={`${empresa.nombre} — inicio`}>
      <img
        src={ruta('/imgs/logo/logow.svg')}
        alt={empresa.nombre}
        width="180"
        height="52"
        class="h-9 w-auto sm:h-11"
      />
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Principal">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="rounded-md px-3 py-2 text-sm font-medium text-asfalto-300 transition hover:bg-white/10 hover:text-white"
          >
            {l.texto}
          </a>
        ))
      }
      <a
        href={`tel:${empresa.telefonoPrincipalLink}`}
        class="ml-2 rounded-md bg-rojo-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-rojo-600"
      >
        {empresa.telefonoPrincipal}
      </a>
    </nav>

    <div class="flex items-center gap-1">
      <button
        id="theme-toggle-btn"
        type="button"
        class="rounded-md p-2.5 text-asfalto-300 transition hover:bg-white/10 hover:text-white"
        aria-label="Cambiar entre modo claro y oscuro"
      >
        <svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke-linecap="round"></path>
        </svg>
      </button>

      <button
        id="hamburger-button"
        type="button"
        class="rounded-md p-2 text-white transition hover:bg-white/10 lg:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-white/10 lg:hidden">
    <nav class="mx-auto max-w-7xl px-4 py-2 sm:px-6" aria-label="Principal móvil">
      <ul class="flex flex-col">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="block rounded-md px-2 py-3 font-medium text-asfalto-300 hover:bg-white/10 hover:text-white">
                {l.texto}
              </a>
            </li>
          ))
        }
        <li class="py-3">
          <a
            href={`tel:${empresa.telefonoPrincipalLink}`}
            class="block rounded-md bg-rojo-500 px-4 py-3 text-center font-semibold text-white"
          >
            Llamar {empresa.telefonoPrincipal}
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const btnTema = document.getElementById('theme-toggle-btn');
  btnTema?.addEventListener('click', () => {
    const oscuro = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', oscuro ? 'dark' : 'light');
  });

  const hamburguesa = document.getElementById('hamburger-button');
  const menu = document.getElementById('mobile-menu');
  hamburguesa?.addEventListener('click', () => {
    const abierto = menu?.classList.toggle('hidden') === false;
    hamburguesa.setAttribute('aria-expanded', String(abierto));
    hamburguesa.setAttribute('aria-label', abierto ? 'Cerrar menú' : 'Abrir menú');
  });
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      menu.classList.add('hidden');
      hamburguesa?.setAttribute('aria-expanded', 'false');
    })
  );
</script>
