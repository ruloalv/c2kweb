---
import TituloSeccion from './TituloSeccion.astro';
import { empresa, wa } from '../config/empresa';
---

<section id="contacto" class="bg-asfalto-900 py-20 text-white sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <TituloSeccion
      etiqueta="Hablemos"
      titulo="Contacto"
      bajada="Escribinos al área que necesites y te respondemos por WhatsApp. Para presupuestos, contanos la ubicación y el volumen aproximado."
      centrado
    />

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {
        empresa.contactos.map((c) => (
          <article class="revelar flex flex-col rounded-2xl border border-white/10 bg-asfalto-800 p-7">
            <h3 class="text-lg font-bold">{c.titulo}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-asfalto-300">{c.texto}</p>
            {'telefono' in c && (
              <p class="mt-4 text-sm">
                <a href={`tel:${c.telefonoLink}`} class="enlace-toque font-semibold text-amarillo">
                  Tel. {c.telefono}
                </a>
              </p>
            )}
            <a
              href={wa(c.whatsapp, `Hola, quiero consultar por ${c.titulo.toLowerCase()}.`)}
              target="_blank"
              rel="noopener"
              class="mt-6 rounded-lg bg-whatsapp px-5 py-3.5 text-center font-bold text-asfalto-950 transition hover:bg-white"
            >
              Escribir por WhatsApp
            </a>
          </article>
        ))
      }
    </div>

    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {
        empresa.sedes.map((s) => (
          <div class="rounded-2xl border border-white/10 p-7">
            <h3 class="text-sm font-bold uppercase tracking-widest text-amarillo">{s.ciudad}</h3>
            <p class="mt-3 text-lg font-semibold">{s.direccion}</p>
            <p class="mt-1 text-asfalto-300">{s.provincia}</p>
            <p class="mt-2 text-sm text-asfalto-300">Cel. {s.celular}</p>
            <div class="mt-4 flex flex-wrap gap-3">
              <a
                href={`tel:${s.telefonoLink}`}
                class="rounded-lg bg-rojo-500 px-5 py-2.5 text-sm font-semibold transition hover:bg-rojo-600"
              >
                {s.telefono}
              </a>
              <a
                href={s.mapa}
                target="_blank"
                rel="noopener"
                class="rounded-lg border border-white/25 px-5 py-2.5 text-sm font-semibold transition hover:bg-white/10"
              >
                Ver en el mapa
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <p class="mt-8 text-center text-asfalto-300">
      También podés escribirnos a
      <a href={`mailto:${empresa.email}`} class="font-semibold text-amarillo underline underline-offset-4">
        {empresa.email}
      </a>
    </p>
  </div>
</section>
