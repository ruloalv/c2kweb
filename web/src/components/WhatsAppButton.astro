---
import { empresa, wa } from '../config/empresa';

interface Props {
  mensaje?: string;
}
const { mensaje = 'Hola, quiero más información sobre sus productos y servicios.' } = Astro.props;
---

<a
  href={wa(empresa.whatsappPrincipal, mensaje)}
  target="_blank"
  rel="noopener noreferrer"
  class="fixed bottom-5 right-5 z-50 flex items-center gap-2 rounded-full bg-whatsapp px-5 py-4 font-bold text-asfalto-950 shadow-lg shadow-black/25 transition hover:bg-white"
  aria-label="Escribir por WhatsApp"
>
  <svg class="h-6 w-6 fill-current" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20.52 3.48A11.88 11.88 0 0012 0a11.92 11.92 0 00-10 18.84L0 24l5.25-1.38A11.89 11.89 0 0012 24c6.63 0 12-5.37 12-12a11.92 11.92 0 00-3.48-8.52zM12 22c-1.85 0-3.63-.48-5.2-1.38l-.37-.21-3.1.81.83-3-.24-.38A9.9 9.9 0 012 12C2 6.48 6.48 2 12 2s10 4.48 10 10-4.48 10-10 10zm5.25-7.38c-.3-.15-1.77-.87-2.05-.96-.27-.09-.47-.15-.66.15s-.75.96-.92 1.14c-.18.18-.33.21-.63.06s-1.23-.45-2.34-1.41c-.86-.77-1.44-1.71-1.61-2-.18-.3-.02-.46.13-.61.13-.13.3-.33.45-.51.15-.18.2-.3.3-.5s.05-.36-.03-.51c-.08-.15-.66-1.6-.9-2.19s-.47-.45-.66-.46h-.56c-.18 0-.46.06-.7.33s-.91.9-.91 2.2.93 2.55 1.06 2.73c.13.18 1.82 2.78 4.41 3.9.62.27 1.1.42 1.48.54.62.2 1.18.18 1.62.11.5-.07 1.54-.63 1.76-1.24.22-.6.22-1.12.15-1.24-.06-.12-.26-.18-.55-.3z"></path>
  </svg>
  <span class="hidden sm:inline">WhatsApp</span>
</a>
