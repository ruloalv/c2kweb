---
import { precios, fechaLegible, notaBadenes } from '../config/precios';
import { empresa } from '../config/empresa';

// Todo lo que necesita el navegador para calcular, en un solo objeto.
// Las observaciones: las fijas de precios.ts más la del badén, que se arma
// con los valores de ese mismo archivo.
const notas = [...precios.notasDestacadas, notaBadenes()];

const config = {
  obras: precios.obras,
  adicionales: precios.adicionales,
  anchoMediaCalzada: precios.anchoMediaCalzada,
  dolarReferencia: precios.dolarReferencia,
  fuenteDolar: precios.fuenteDolar,
  ajustarPorDolar: precios.ajustarPorDolar,
  fecha: precios.fechaActualizacion,
  fechaLegible: fechaLegible(),
  vigenciaDias: precios.vigenciaDias,
  whatsapp: empresa.whatsappPrincipal,
};
---

<div
  id="calculadora"
  class="overflow-hidden rounded-3xl border border-asfalto-100 bg-white shadow-xl dark:border-white/10 dark:bg-asfalto-800"
>
  <div class="grid lg:grid-cols-5">
    <!-- Columna de datos -->
    <form class="p-7 sm:p-9 lg:col-span-3" id="calc-form" novalidate>
      <h3 class="text-2xl font-bold">Calculá tu frente</h3>
      <p class="mt-2 text-asfalto-600 dark:text-asfalto-300">
        Poné los metros de frente de tu lote y elegí el tipo de calzada. El cálculo toma
        <strong>media calzada ({precios.anchoMediaCalzada} m de ancho)</strong>, que es lo que le
        corresponde al frentista de cada vereda.
      </p>

      <!-- Metros de frente -->
      <div class="mt-8">
        <label for="frente" class="block font-semibold">Metros de frente de tu lote</label>
        <div class="mt-3 flex items-center gap-4">
          <input
            id="frente"
            name="frente"
            type="range"
            min="4"
            max="60"
            step="0.5"
            value="10"
            class="flex-1"
          />
          <div class="flex items-center gap-1 rounded-lg border border-asfalto-100 px-3 py-2 dark:border-white/15">
            <input
              id="frente-num"
              type="number"
              min="1"
              max="200"
              step="0.5"
              value="10"
              inputmode="decimal"
              class="w-16 bg-transparent text-right text-lg font-bold outline-none"
              aria-label="Metros de frente"
            />
            <span class="text-asfalto-600 dark:text-asfalto-300">m</span>
          </div>
        </div>
      </div>

      <!--
        Qué trabajos entran. Cada uno se puede pedir por separado: hay cuadras
        que solo necesitan el cordón cuneta.
      -->
      <fieldset class="mt-8">
        <legend class="font-semibold">¿Qué trabajos necesitás?</legend>
        <div id="trabajos-lista" class="mt-3 grid gap-3"></div>
      </fieldset>

      <!-- Aparece solo si se pidió pavimento -->
      <fieldset id="grupo-calzada" class="mt-6 rounded-xl bg-asfalto-50 p-5 dark:bg-asfalto-900" hidden>
        <legend class="px-1 font-semibold">Tipo de calzada</legend>
        <div id="obras-lista" class="mt-2 grid gap-3 sm:grid-cols-2"></div>
      </fieldset>

    </form>

    <!-- Columna de resultado -->
    <aside class="flex flex-col bg-asfalto-900 p-7 text-white sm:p-9 lg:col-span-2">
      <p class="text-sm font-semibold uppercase tracking-widest text-amarillo">Estimado</p>

      <p id="total" class="mt-3 text-4xl font-extrabold tracking-tight sm:text-5xl" aria-live="polite">—</p>
      <p id="por-metro" class="mt-2 text-sm text-asfalto-300"></p>

      <ul id="desglose" class="mt-6 space-y-2 border-t border-white/10 pt-6 text-sm text-asfalto-300"></ul>

      <div
        id="aviso-vencido"
        class="mt-6 hidden rounded-lg border border-amarillo/40 bg-amarillo/10 p-3 text-sm text-amarillo"
      >
        Estos valores tienen más de {precios.vigenciaDias} días. Consultanos el precio vigente antes de decidir.
      </div>

      <a
        id="wa-cotizar"
        href={`https://wa.me/${empresa.whatsappPrincipal}`}
        target="_blank"
        rel="noopener"
        class="mt-6 rounded-lg bg-whatsapp px-5 py-4 text-center font-bold text-asfalto-950 transition hover:bg-white"
      >
        Pedir presupuesto con estos datos
      </a>

      <p id="referencia" class="mt-4 text-xs leading-relaxed text-asfalto-300"></p>
    </aside>
  </div>

  <!-- Lo que más pregunta la gente. Se edita en config/precios.ts -->
  <div
    class="grid gap-6 border-t border-asfalto-100 bg-amarillo/15 px-7 py-6 dark:border-white/10 sm:px-9 md:grid-cols-3"
  >
    {
      notas.map((n) => (
        <div class="flex gap-4">
          <svg
            class="mt-0.5 h-6 w-6 shrink-0 text-amarillo-600 dark:text-amarillo"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="9" />
            <path d="M9 12.5l2 2 4-4.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <div>
            <h4 class="font-bold">{n.titulo}</h4>
            <p class="mt-1 text-sm leading-relaxed text-asfalto-600 dark:text-asfalto-300">
              {n.texto}
            </p>
          </div>
        </div>
      ))
    }
  </div>

  <div class="border-t border-asfalto-100 bg-asfalto-50 px-7 py-6 dark:border-white/10 dark:bg-asfalto-900 sm:px-9">
    <h4 class="text-sm font-bold uppercase tracking-wider text-asfalto-600 dark:text-asfalto-300">
      Tener en cuenta
    </h4>
    <ul class="mt-3 grid gap-2 text-sm text-asfalto-600 dark:text-asfalto-300 sm:grid-cols-2">
      {
        precios.aclaraciones.map((a) => (
          <li class="flex gap-2">
            <span aria-hidden="true">·</span>
            {a}
          </li>
        ))
      }
    </ul>
  </div>
</div>

<script is:inline define:vars={{ config }}>
  (function () {
    const $ = (id) => document.getElementById(id);
    const money = new Intl.NumberFormat('es-AR', {
      style: 'currency',
      currency: 'ARS',
      maximumFractionDigits: 0,
    });

    // Factor de actualización por dólar. Arranca en 1 (el precio del día que se
    // cargó) y se corrige si la API del dólar responde.
    let factor = 1;
    let dolarHoy = null;

    // --- Pintar opciones ---
    const tarjeta =
      'flex cursor-pointer gap-3 rounded-xl border border-asfalto-100 p-4 transition ' +
      'has-[:checked]:border-rojo-500 has-[:checked]:bg-rojo-500/5 dark:border-white/15';

    const opcion = (tipo, name, valor, titulo, detalle, extra) =>
      '<label class="' +
      tarjeta +
      '"><input type="' +
      tipo +
      '" name="' +
      name +
      '" value="' +
      valor +
      '" class="mt-1 h-4 w-4 ' +
      (tipo === 'checkbox' ? 'rounded ' : '') +
      'accent-rojo-500"' +
      (extra || '') +
      ' /><span><span class="block font-semibold">' +
      titulo +
      '</span>' +
      (detalle
        ? '<span class="mt-1 block text-sm text-asfalto-600 dark:text-asfalto-300">' +
          detalle +
          '</span>'
        : '') +
      '</span></label>';

    // Los trabajos que se pueden pedir. El pavimento va primero y viene tildado;
    // los demás se suman o se piden solos.
    const trabajos = [
      {
        id: 'pavimento',
        nombre: 'Pavimento de calzada',
        detalle: 'Media calzada frente a tu lote.',
        porDefecto: true,
      },
      ...config.adicionales.map((a) => ({
        id: a.id,
        nombre: a.nombre,
        detalle: a.detalle,
        porDefecto: false,
      })),
    ];

    $('trabajos-lista').innerHTML = trabajos
      .map((t) =>
        opcion(
          'checkbox',
          'trabajo',
          t.id,
          t.nombre,
          t.detalle,
          t.porDefecto ? ' checked' : ''
        )
      )
      .join('');

    $('obras-lista').innerHTML = config.obras
      .map((o, i) => opcion('radio', 'obra', o.id, o.nombre, o.detalle, i === 0 ? ' checked' : ''))
      .join('');

    // El tipo de calzada solo aplica si se pidió pavimento. Se usa el atributo
    // `hidden` y no una clase, para que lo oculto salga del orden de tabulación
    // y del árbol de accesibilidad.
    function sincronizarGrupos() {
      $('grupo-calzada').hidden = !document.querySelector(
        'input[name="trabajo"][value="pavimento"]:checked'
      );
    }

    // --- Sincronizar la barra con el número ---
    const rango = $('frente');
    const numero = $('frente-num');
    rango.addEventListener('input', () => {
      numero.value = rango.value;
      calcular();
    });
    numero.addEventListener('input', () => {
      const v = parseFloat(numero.value);
      if (!isNaN(v)) rango.value = String(Math.min(60, Math.max(4, v)));
      calcular();
    });

    // 'change' cubre los tildes y radios; 'input' hace que el campo numérico
    // del frente recalcule mientras se escribe.
    $('calc-form').addEventListener('change', calcular);
    $('calc-form').addEventListener('input', calcular);
    $('calc-form').addEventListener('submit', (e) => e.preventDefault());

    // --- Cálculo ---
    function metros() {
      return Math.max(0, parseFloat(numero.value) || 0);
    }

    // Se redondea a mil para que quede claro que es una estimación.
    const redondear = (n) => Math.round(n / 1000) * 1000;

    // Deja el resultado en blanco con un mensaje de qué falta cargar.
    function vaciar(mensaje) {
      $('total').textContent = '—';
      $('desglose').innerHTML = '';
      $('por-metro').textContent = mensaje;
    }

    function calcular() {
      sincronizarGrupos();

      const m = metros();
      const pedido = (id) =>
        !!document.querySelector('input[name="trabajo"][value="' + id + '"]:checked');

      const seleccion = document.querySelector('input[name="obra"]:checked');
      const obra = pedido('pavimento') && seleccion
        ? config.obras.find((o) => o.id === seleccion.value)
        : null;

      const elegidos = config.adicionales.filter((a) => pedido(a.id));

      if (m <= 0) {
        vaciar('Cargá los metros de frente');
        return;
      }
      if (!obra && elegidos.length === 0) {
        vaciar('Elegí al menos un trabajo');
        return;
      }

      const filas = [];
      const lineasWa = [];
      let total = 0;

      if (obra) {
        // La calzada se cobra por m²: metros de frente por el ancho de media calzada.
        const superficie = m * config.anchoMediaCalzada;
        const precioObra = obra.precioM2 * factor * config.anchoMediaCalzada;
        total += precioObra * m;
        filas.push([obra.nombre + ' · ' + superficie.toLocaleString('es-AR') + ' m²', precioObra * m]);
        lineasWa.push(
          'Pavimento: ' + obra.nombre + ' — ' + superficie.toLocaleString('es-AR') + ' m² (media calzada)'
        );
      }

      for (const ad of elegidos) {
        const p = ad.precioPorMetroFrente * factor;
        total += p * m;
        filas.push([ad.nombre + ' · ' + m.toLocaleString('es-AR') + ' m', p * m]);
        lineasWa.push(ad.nombre + ': ' + m.toLocaleString('es-AR') + ' m');
      }

      total = redondear(total);

      $('total').textContent = money.format(total);
      $('por-metro').textContent = money.format(redondear(total / m)) + ' por metro de frente';
      $('desglose').innerHTML = filas
        .map(
          (f) =>
            '<li class="flex justify-between gap-4"><span>' +
            f[0] +
            '</span><span class="shrink-0 font-semibold text-white">' +
            (f[1] === null ? 'a cotizar' : money.format(redondear(f[1]))) +
            '</span></li>'
        )
        .join('');

      // Mensaje de WhatsApp con todo el detalle ya escrito.
      const detalle = [
        'Hola, hice el cálculo en la web y quiero un presupuesto.',
        '',
        'Frente: ' + m.toLocaleString('es-AR') + ' m',
        ...lineasWa,
        'Estimado del sitio: ' + money.format(total),
        '',
        'Mi dirección es:',
      ].join('\n');
      $('wa-cotizar').href = 'https://wa.me/' + config.whatsapp + '?text=' + encodeURIComponent(detalle);

      // Pie con la fecha del precio base y el dólar con el que se ajustó.
      const base = 'Precios de referencia al ' + config.fechaLegible + '.';
      $('referencia').textContent = dolarHoy
        ? base + ' Actualizados con el dólar ' + config.fuenteDolar + ' de hoy ($' + dolarHoy.toLocaleString('es-AR') + ').'
        : base + ' Valor sin ajustar por tipo de cambio.';
    }

    // --- Aviso cuando los precios quedaron viejos ---
    const dias = Math.floor((Date.now() - new Date(config.fecha + 'T00:00:00').getTime()) / 86400000);
    if (dias > config.vigenciaDias) $('aviso-vencido').classList.remove('hidden');

    // --- Dólar del día ---
    async function traerDolar() {
      if (!config.ajustarPorDolar) return;
      try {
        const r = await fetch('https://dolarapi.com/v1/dolares/' + config.fuenteDolar, { cache: 'no-store' });
        if (!r.ok) return;
        const d = await r.json();
        const venta = Number(d.venta);
        if (venta > 0 && config.dolarReferencia > 0) {
          dolarHoy = venta;
          factor = venta / config.dolarReferencia;
        }
      } catch (e) {
        // Sin internet o API caída: queda el precio base con su fecha.
      }
    }

    calcular();
    traerDolar().then(calcular);
  })();
</script>
