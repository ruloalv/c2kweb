---
import { productos } from '../data/productos';
import { empresa, wa } from '../config/empresa';
import TituloSeccion from './TituloSeccion.astro';

const numeroDe = (id: string) =>
  empresa.contactos.find((c) => c.id === id)?.whatsapp ?? empresa.whatsappPrincipal;
---

<section id="productos" class="bg-asfalto-50 py-20 dark:bg-asfalto-900 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <TituloSeccion
      etiqueta="Qué hacemos"
      titulo="Productos y servicios"
      bajada="Producimos, transportamos y colocamos. Al ser dueños de la planta y de los equipos, controlamos la calidad y los plazos de punta a punta."
    />

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        productos.map((p) => (
          <article class="revelar group flex flex-col rounded-2xl border border-asfalto-100 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:border-rojo-500/40 hover:shadow-xl dark:border-white/10 dark:bg-asfalto-800">
            {p.etiqueta && (
              <span class="mb-3 self-start rounded-full bg-amarillo px-3 py-1 text-xs font-bold uppercase tracking-wide text-asfalto-950">
                {p.etiqueta}
              </span>
            )}
            <h3 class="text-xl font-bold">{p.nombre}</h3>
            <p class="mt-2 text-asfalto-600 dark:text-asfalto-300">{p.bajada}</p>

            <ul class="mt-5 flex-1 space-y-2 text-sm text-asfalto-600 dark:text-asfalto-300">
              {p.detalle.map((d) => (
                <li class="flex gap-2">
                  <svg class="mt-1 h-4 w-4 shrink-0 text-rojo-500 dark:text-amarillo" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path
                      fill-rule="evenodd"
                      d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.8 3.8 6.8-6.8a1 1 0 0 1 1.4 0z"
                      clip-rule="evenodd"
                    />
                  </svg>
                  <span>{d}</span>
                </li>
              ))}
            </ul>

            <a
              href={wa(numeroDe(p.contacto), `Hola, quiero consultar por ${p.nombre}.`)}
              target="_blank"
              rel="noopener"
              class="mt-6 inline-flex items-center gap-1 font-semibold text-rojo-500 transition group-hover:gap-2 dark:text-amarillo"
            >
              Consultar
              <span aria-hidden="true">→</span>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
