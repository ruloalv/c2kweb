---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { empresa } from '../config/empresa';
import { ruta } from '../config/rutas';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  /** Para páginas internas que no tienen que aparecer en buscadores. */
  noindex?: boolean;
}

const {
  title = `${empresa.nombre} — Pavimentos, asfalto y hormigón`,
  description = empresa.descripcion,
  path = '/',
  noindex = false,
} = Astro.props;

// Astro.site sale de astro.config.mjs y cambia según dónde se publique.
const origen = Astro.site?.href ?? empresa.sitio;

// Páginas que tienen gemela en markdown. Las internas, como /precios, no.
const gemelas: Record<string, string> = { '/': '/index.md', '/vecinos': '/vecinos.md' };
const versionMarkdown = gemelas[path];
const canonical = new URL(ruta(path), origen).href;
const ogImage = new URL(ruta('/og.jpg'), origen).href;

// Datos estructurados para que Google entienda quiénes somos y dónde estamos.
// Una sucursal por sede, para que cada una pueda aparecer en el mapa.
const sucursales = empresa.sedes.map((s) => ({
  '@type': 'LocalBusiness',
  '@id': `${origen}#${s.ciudad.toLowerCase().replace(/[^a-z]/g, '')}`,
  name: `${empresa.nombre} — ${s.ciudad}`,
  parentOrganization: { '@id': `${origen}#empresa` },
  address: {
    '@type': 'PostalAddress',
    streetAddress: s.direccion,
    addressLocality: s.ciudad,
    addressRegion: s.provincia,
    addressCountry: 'AR',
  },
  telephone: s.telefonoLink,
  email: empresa.email,
  hasMap: s.mapa,
  // Solo las sedes con coordenadas cargadas. Ayuda a que Google las ubique
  // en el mapa en vez de deducirlas de la dirección.
  ...('lat' in s && 'lng' in s
    ? { geo: { '@type': 'GeoCoordinates', latitude: s.lat, longitude: s.lng } }
    : {}),
}));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  '@id': `${origen}#empresa`,
  name: empresa.nombre,
  alternateName: empresa.nombreCorto,
  description: empresa.descripcion,
  url: empresa.sitio,
  email: empresa.email,
  image: ogImage,
  foundingDate: String(empresa.anioInicio),
  knowsLanguage: 'es-AR',
  areaServed: [
    'Buenos Aires',
    'La Pampa',
    'Río Negro',
    'Neuquén',
    'Chubut',
    'Argentina',
  ].map((n) => ({ '@type': 'AdministrativeArea', name: n })),
  address: empresa.sedes.map((s) => ({
    '@type': 'PostalAddress',
    streetAddress: s.direccion,
    addressLocality: s.ciudad,
    addressRegion: s.provincia,
    addressCountry: 'AR',
  })),
  location: sucursales,
  telephone: empresa.sedes.map((s) => s.telefonoLink),
  makesOffer: [
    'Mezclas asfálticas en caliente',
    'Asfalto en frío Rapibach y Rapirod',
    'Hormigón elaborado',
    'Movimiento de suelos',
    'Pavimentación urbana y rutas',
  ].map((n) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: n } })),
};
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#14171c" />

    <!-- Permite a Google mostrar la imagen grande y el texto completo en el resultado -->
    <meta
      name="robots"
      content={
        noindex
          ? 'noindex, nofollow'
          : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
      }
    />
    <meta name="author" content={empresa.nombre} />
    <meta name="geo.region" content="AR-B" />
    <meta name="geo.placename" content="Pigüé, Bahía Blanca" />

    <!-- Para asistentes de IA: esta misma página en markdown, y el resumen del sitio -->
    {
      versionMarkdown && (
        <link
          rel="alternate"
          type="text/markdown"
          href={new URL(ruta(versionMarkdown), origen).href}
          title={`${title} (markdown)`}
        />
      )
    }
    <link rel="alternate" type="text/plain" href={new URL(ruta('/llms.txt'), origen).href} title="llms.txt" />
    <link
      rel="sitemap"
      type="application/xml"
      href={new URL(ruta('/sitemap-index.xml'), origen).href}
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={empresa.nombre} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Planta de asfalto y hormigón de Carreteras 2000" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href={ruta('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={ruta('/imgs/logo/icono.png')} />

    <script is:inline>
      // Se aplica el tema antes de pintar, para que no haya un parpadeo blanco.
      (function () {
        // Marca que hay JavaScript: las animaciones de entrada dependen de esto.
        document.documentElement.classList.add('js');
        try {
          var guardado = localStorage.getItem('theme');
          var oscuro = guardado
            ? guardado === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (oscuro) document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>

  <body class="bg-white text-asfalto-900 dark:bg-asfalto-950 dark:text-asfalto-100 antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-3 focus:rounded-lg focus:bg-amarillo focus:px-4 focus:py-2 focus:font-semibold focus:text-asfalto-950"
    >
      Ir al contenido
    </a>

    <Header />

    <main id="contenido">
      <slot />
    </main>

    <Footer />
    <WhatsAppButton />

    <script>
      // Revelado suave de secciones al hacer scroll.
      const objetivos = document.querySelectorAll('.revelar');
      if (objetivos.length) {
        const io = new IntersectionObserver(
          (entradas) => {
            for (const e of entradas) {
              if (e.isIntersecting) {
                e.target.classList.add('visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px' }
        );
        objetivos.forEach((el, i) => {
          (el as HTMLElement).style.transitionDelay = `${Math.min(i % 4, 3) * 70}ms`;
          io.observe(el);
        });
      }
    </script>
  </body>
</html>
