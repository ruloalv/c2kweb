---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { empresa } from '../config/empresa';

interface Props {
  title?: string;
  description?: string;
  path?: string;
}

const {
  title = `${empresa.nombre} — Pavimentos, asfalto y hormigón`,
  description = empresa.descripcion,
  path = '/',
} = Astro.props;

const canonical = new URL(path, empresa.sitio).href;
const ogImage = new URL('/og.jpg', empresa.sitio).href;

// Datos estructurados para que Google entienda quiénes somos y dónde estamos.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  name: empresa.nombre,
  description: empresa.descripcion,
  url: empresa.sitio,
  email: empresa.email,
  foundingDate: String(empresa.anioInicio),
  areaServed: 'Argentina',
  address: empresa.sedes.map((s) => ({
    '@type': 'PostalAddress',
    streetAddress: s.direccion,
    addressLocality: s.ciudad,
    addressRegion: s.provincia,
    addressCountry: 'AR',
  })),
  telephone: empresa.sedes.map((s) => s.telefonoLink),
  makesOffer: [
    'Mezclas asfálticas en caliente',
    'Asfalto en frío Rapibach y Rapirod',
    'Hormigón elaborado',
    'Movimiento de suelos',
    'Pavimentación urbana y rutas',
  ].map((n) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: n } })),
};
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#14171c" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={empresa.nombre} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Planta de asfalto y hormigón de Carreteras 2000" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/imgs/logo/icono.png" />

    <script is:inline>
      // Se aplica el tema antes de pintar, para que no haya un parpadeo blanco.
      (function () {
        // Marca que hay JavaScript: las animaciones de entrada dependen de esto.
        document.documentElement.classList.add('js');
        try {
          var guardado = localStorage.getItem('theme');
          var oscuro = guardado
            ? guardado === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (oscuro) document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>

  <body class="bg-white text-asfalto-900 dark:bg-asfalto-950 dark:text-asfalto-100 antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-3 focus:rounded-lg focus:bg-amarillo focus:px-4 focus:py-2 focus:font-semibold focus:text-asfalto-950"
    >
      Ir al contenido
    </a>

    <Header />

    <main id="contenido">
      <slot />
    </main>

    <Footer />
    <WhatsAppButton />

    <script>
      // Revelado suave de secciones al hacer scroll.
      const objetivos = document.querySelectorAll('.revelar');
      if (objetivos.length) {
        const io = new IntersectionObserver(
          (entradas) => {
            for (const e of entradas) {
              if (e.isIntersecting) {
                e.target.classList.add('visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px' }
        );
        objetivos.forEach((el, i) => {
          (el as HTMLElement).style.transitionDelay = `${Math.min(i % 4, 3) * 70}ms`;
          io.observe(el);
        });
      }
    </script>
  </body>
</html>
