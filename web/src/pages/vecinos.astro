---
import BaseLayout from '../layouts/BaseLayout.astro';
import JuntarCuadra from '../components/JuntarCuadra.astro';
import TituloSeccion from '../components/TituloSeccion.astro';
import { empresa, wa } from '../config/empresa';
import { programa, reunionesVigentes, fechaReuniones } from '../config/programa';
import { ruta } from '../config/rutas';
import { pasos, preguntas } from '../data/vecinos';

const origen = Astro.site?.href ?? empresa.sitio;
const hayReuniones = reunionesVigentes();

// Las mismas preguntas, en el formato que entiende Google. Se muestran como
// desplegables en el resultado de búsqueda.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: preguntas.map((f) => ({
    '@type': 'Question',
    name: f.p,
    acceptedAnswer: { '@type': 'Answer', text: f.r },
  })),
};

// Miga de pan para que Google muestre "Inicio > Vecinos" en vez de la URL.
const migaSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL(ruta('/'), origen).href },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Pavimento para vecinos',
      item: new URL(ruta('/vecinos'), origen).href,
    },
  ],
};

// El paso a paso, para que se entienda como un procedimiento. Es lo que puede
// hacer que Google lo muestre como guía ante "cómo pavimentar mi cuadra".
const pasosSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Cómo inscribir tu cuadra para pavimento en Bahía Blanca',
  description: `Pasos del ${programa.nombre} de la ${programa.municipio} para que los frentistas de una cuadra consigan pavimento, cordón cuneta o vereda con financiación bancaria.`,
  step: pasos.map((p, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: p.titulo,
    text: p.texto,
  })),
};
---

<BaseLayout
  title="Cómo pavimentar tu cuadra en Bahía Blanca — Carreteras 2000 S.A."
  description="Guía del programa municipal de consorcios vecinales: cómo inscribir tu cuadra para pavimento, cordón cuneta o vereda, qué hace falta para que arranque y cómo se financia."
  path="/vecinos"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(migaSchema)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(pasosSchema)} />

  <!-- Encabezado -->
  <section class="bg-asfalto-950 py-16 text-white sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <nav class="text-sm text-asfalto-300" aria-label="Miga de pan">
        <a href={ruta('/')} class="enlace-toque hover:text-white">Inicio</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span class="text-white">Vecinos</span>
      </nav>

      <h1 class="titulo-seccion mt-6 max-w-3xl text-4xl sm:text-5xl lg:text-6xl">
        Tu cuadra puede tener<br />
        <span class="text-amarillo">pavimento este año</span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-asfalto-300">
        La {programa.municipio} abrió un programa para que los vecinos hagan el pavimento, el
        cordón cuneta o la vereda de su cuadra, con financiación de los bancos y supervisión
        técnica del Municipio. Acá te explicamos cómo funciona y te damos una mano para juntar
        a la cuadra.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href={programa.inscripcion}
          target="_blank"
          rel="noopener"
          class="rounded-lg bg-amarillo px-7 py-4 text-center font-bold text-asfalto-950 transition hover:bg-white"
        >
          Inscribir mi cuadra
        </a>
        <a
          href="#como-funciona"
          class="rounded-lg border border-white/25 px-7 py-4 text-center font-semibold transition hover:bg-white/10"
        >
          Ver cómo funciona
        </a>
      </div>
      <p class="mt-4 max-w-2xl text-sm text-asfalto-300">
        Se hace en el portal {programa.portal} del Municipio, en la opción{' '}
        <span class="font-semibold text-amarillo">{programa.opcionPortal}</span>. Es gratis y no
        te obliga a nada.
      </p>
    </div>
  </section>

  <div class="h-2 franja-vial"></div>

  {
    hayReuniones && (
      <section class="bg-amarillo py-6 text-asfalto-950">
        <div class="mx-auto flex max-w-7xl flex-col gap-1 px-4 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:gap-6">
          <p class="shrink-0 text-sm font-bold uppercase tracking-widest">
            Reuniones informativas
          </p>
          <p class="text-base">
            {programa.reuniones.dias} {programa.reuniones.horario}, en el {programa.reuniones.lugar}{' '}
            ({programa.reuniones.direccion}). Hasta el {fechaReuniones()}.
          </p>
        </div>
      </section>
    )
  }

  <!-- Qué es el programa -->
  <section id="como-funciona" class="bg-white py-20 dark:bg-asfalto-950 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <TituloSeccion
        etiqueta="El programa"
        titulo="Qué es y qué cubre"
        bajada="Un esquema nuevo del Municipio para que una cuadra entera resuelva junta la obra que le falta."
      />

      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        <div
          class="rounded-2xl border border-asfalto-100 bg-asfalto-50 p-7 dark:border-white/10 dark:bg-asfalto-900"
        >
          <h3 class="font-bold">Qué obras entran</h3>
          <p class="mt-2 text-sm leading-relaxed text-asfalto-600 dark:text-asfalto-300">
            Pavimento de la calzada, cordón cuneta, y veredas nuevas o a reparar. Se pide lo que
            la cuadra necesita: no hace falta hacer todo junto.
          </p>
        </div>
        <div
          class="rounded-2xl border border-asfalto-100 bg-asfalto-50 p-7 dark:border-white/10 dark:bg-asfalto-900"
        >
          <h3 class="font-bold">Quién hace qué</h3>
          <p class="mt-2 text-sm leading-relaxed text-asfalto-600 dark:text-asfalto-300">
            El Municipio inscribe y supervisa, la Cámara de la Construcción presupuesta y las
            empresas asociadas ejecutan. El acuerdo es entre la Cámara, el vecino y el banco.
          </p>
        </div>
        <div
          class="rounded-2xl border border-asfalto-100 bg-asfalto-50 p-7 dark:border-white/10 dark:bg-asfalto-900"
        >
          <h3 class="font-bold">Cómo se paga</h3>
          <p class="mt-2 text-sm leading-relaxed text-asfalto-600 dark:text-asfalto-300">
            Al contado o financiado. Hay líneas anunciadas por {programa.bancos.join(', ')}, cada
            una con sus plazos y su calificación crediticia. Las condiciones vigentes las publica
            el Municipio.
          </p>
        </div>
      </div>

      <ol class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          pasos.map((p) => (
            <li class="revelar rounded-2xl border border-asfalto-100 bg-white p-7 dark:border-white/10 dark:bg-asfalto-800">
              <span class="text-3xl font-extrabold text-rojo-500 dark:text-amarillo">{p.n}</span>
              <h3 class="mt-3 font-bold">{p.titulo}</h3>
              <p class="mt-2 text-sm leading-relaxed text-asfalto-600 dark:text-asfalto-300">
                {p.texto}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- El cuello de botella: juntar la cuadra -->
  <section class="bg-asfalto-50 py-20 dark:bg-asfalto-900 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <TituloSeccion
        etiqueta="Lo que más cuesta"
        titulo="Juntar a toda la cuadra"
        bajada="La cuadra entra al programa recién cuando se inscriben todos los frentistas. Es donde se traba la mayoría, y donde más podemos ayudarte."
      />

      <div class="mt-12 grid gap-8 lg:grid-cols-5">
        <div class="lg:col-span-3">
          <JuntarCuadra />
        </div>

        <div class="lg:col-span-2">
          <h3 class="text-lg font-bold">Lo que tiene que hacer cada vecino</h3>
          <ol class="mt-5 space-y-5">
            <li class="flex gap-4">
              <span
                class="flex size-8 shrink-0 items-center justify-center rounded-full bg-rojo-500 text-sm font-bold text-white"
                aria-hidden="true"
              >
                1
              </span>
              <p class="text-sm leading-relaxed text-asfalto-600 dark:text-asfalto-300">
                Registrarse una vez en {programa.portal}, con DNI, ANSES, ARCA o Mi Argentina.
              </p>
            </li>
            <li class="flex gap-4">
              <span
                class="flex size-8 shrink-0 items-center justify-center rounded-full bg-rojo-500 text-sm font-bold text-white"
                aria-hidden="true"
              >
                2
              </span>
              <p class="text-sm leading-relaxed text-asfalto-600 dark:text-asfalto-300">
                Entrar a la opción <strong class="font-semibold">{programa.opcionPortal}</strong>,
                cargar su domicilio y marcar qué necesita la cuadra.
              </p>
            </li>
            <li class="flex gap-4">
              <span
                class="flex size-8 shrink-0 items-center justify-center rounded-full bg-rojo-500 text-sm font-bold text-white"
                aria-hidden="true"
              >
                3
              </span>
              <p class="text-sm leading-relaxed text-asfalto-600 dark:text-asfalto-300">
                Avisarle al grupo que ya se anotó, así se sabe cuántos faltan.
              </p>
            </li>
          </ol>

          <div
            class="mt-8 rounded-xl border border-asfalto-100 bg-white p-5 dark:border-white/10 dark:bg-asfalto-800"
          >
            <p class="text-sm font-semibold">¿Dudas sobre el programa?</p>
            <p class="mt-2 text-sm leading-relaxed text-asfalto-600 dark:text-asfalto-300">
              El Municipio atiende consultas por WhatsApp al {programa.whatsappLegible}.
            </p>
            <a
              href={programa.inscripcion}
              target="_blank"
              rel="noopener"
              class="enlace-toque mt-4 inline-block font-semibold text-rojo-600 underline underline-offset-4 dark:text-amarillo"
            >
              Ir al portal de inscripción
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Acompañamiento -->
  <section class="bg-white py-20 dark:bg-asfalto-950 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <TituloSeccion
        etiqueta="Estamos para ayudarte"
        titulo="No tenés que arreglártelas solo"
        bajada="Llevamos más de veinte años haciendo pavimento en la zona. Lo que sabemos está a tu disposición, sin cargo y sin compromiso."
      />

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <div
          class="revelar rounded-2xl border border-asfalto-100 bg-asfalto-50 p-7 dark:border-white/10 dark:bg-asfalto-900"
        >
          <h3 class="font-bold">Te explicamos el programa</h3>
          <p class="mt-2 text-sm leading-relaxed text-asfalto-600 dark:text-asfalto-300">
            Cómo es la inscripción, qué pasa después y qué podés esperar en cada etapa. Las dudas
            que tengas, por WhatsApp o por teléfono.
          </p>
        </div>
        <div
          class="revelar rounded-2xl border border-asfalto-100 bg-asfalto-50 p-7 dark:border-white/10 dark:bg-asfalto-900"
        >
          <h3 class="font-bold">Vamos a la reunión de la cuadra</h3>
          <p class="mt-2 text-sm leading-relaxed text-asfalto-600 dark:text-asfalto-300">
            Si juntás a los vecinos, vamos y se lo explicamos a todos juntos. Suele ser lo que
            destraba a los que todavía dudan.
          </p>
        </div>
        <div
          class="revelar rounded-2xl border border-asfalto-100 bg-asfalto-50 p-7 dark:border-white/10 dark:bg-asfalto-900"
        >
          <h3 class="font-bold">Miramos tu cuadra</h3>
          <p class="mt-2 text-sm leading-relaxed text-asfalto-600 dark:text-asfalto-300">
            Cómo escurre el agua, en qué estado está la calle, si conviene cordón cuneta antes
            que pavimento. Te lo decimos de frente.
          </p>
        </div>
        <div
          class="revelar rounded-2xl border border-asfalto-100 bg-asfalto-50 p-7 dark:border-white/10 dark:bg-asfalto-900"
        >
          <h3 class="font-bold">Te avisamos qué resolver antes</h3>
          <p class="mt-2 text-sm leading-relaxed text-asfalto-600 dark:text-asfalto-300">
            Conexiones de agua, gas o cloacas que convenga hacer ahora, mientras la calle está
            abierta. Después hay que romper el pavimento.
          </p>
        </div>
      </div>

      <div
        class="mt-10 flex flex-col items-start gap-5 rounded-2xl bg-asfalto-50 p-7 dark:bg-asfalto-900 lg:flex-row lg:items-center lg:justify-between"
      >
        <p class="max-w-2xl leading-relaxed text-asfalto-600 dark:text-asfalto-300">
          Nada de esto te compromete con nosotros ni te asegura que hagamos tu cuadra: la obra la
          asigna la Cámara de la Construcción. Lo hacemos porque cuantas más cuadras se inscriban,
          más obra hay en la ciudad.
        </p>
        <a
          href={wa(
            empresa.whatsappPrincipal,
            'Hola, quiero inscribir mi cuadra en el programa del Municipio y necesito una mano.'
          )}
          target="_blank"
          rel="noopener"
          class="shrink-0 rounded-lg bg-whatsapp px-7 py-4 font-bold text-asfalto-950 transition hover:brightness-95"
        >
          Consultanos por WhatsApp
        </a>
      </div>
    </div>
  </section>

  <!-- Fuera de Bahía Blanca -->
  <section class="bg-asfalto-50 py-16 dark:bg-asfalto-900 sm:py-20">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
      <h2 class="titulo-seccion text-2xl sm:text-3xl">¿Vivís fuera de Bahía Blanca?</h2>
      <p class="mt-4 leading-relaxed text-asfalto-600 dark:text-asfalto-300">
        El programa es solo del partido de Bahía Blanca. En Pigüé y el resto de la zona seguimos
        trabajando directo con el grupo de vecinos, como siempre. Escribinos y lo vemos juntos.
      </p>
      <a
        href={wa(
          empresa.whatsappPrincipal,
          'Hola, somos vecinos de fuera de Bahía Blanca y queremos hacer la obra de nuestra cuadra.'
        )}
        target="_blank"
        rel="noopener"
        class="mt-6 inline-block rounded-lg bg-whatsapp px-7 py-4 font-bold text-asfalto-950 transition hover:brightness-95"
      >
        Consultar por WhatsApp
      </a>
    </div>
  </section>

  <!-- Preguntas -->
  <section class="bg-white py-20 dark:bg-asfalto-950 sm:py-24">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <TituloSeccion etiqueta="Dudas frecuentes" titulo="Preguntas de vecinos" centrado />

      <div class="mt-12 divide-y divide-asfalto-100 dark:divide-white/10">
        {
          preguntas.map((f) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer items-center justify-between gap-4 font-semibold marker:content-['']">
                {f.p}
                <span
                  class="shrink-0 text-2xl leading-none text-rojo-500 transition group-open:rotate-45 dark:text-amarillo"
                  aria-hidden="true"
                >
                  +
                </span>
              </summary>
              <p class="mt-3 leading-relaxed text-asfalto-600 dark:text-asfalto-300">{f.r}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Cierre -->
  <section class="bg-asfalto-900 py-16 text-white sm:py-20">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
      <h2 class="titulo-seccion text-3xl sm:text-4xl">Anotá tu cuadra</h2>
      <p class="mt-4 text-lg text-asfalto-300">
        Entrá a {programa.portal}, buscá la opción {programa.opcionPortal} y pedí tu cuadra.
        Si algo no se entiende, escribinos: te acompañamos en lo que haga falta.
      </p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a
          href={programa.inscripcion}
          target="_blank"
          rel="noopener"
          class="rounded-lg bg-amarillo px-7 py-4 font-bold text-asfalto-950 transition hover:bg-white"
        >
          Inscribirme en {programa.portal}
        </a>
        <a
          href={wa(
            empresa.whatsappPrincipal,
            'Hola, queremos inscribir nuestra cuadra en el programa del Municipio y tengo algunas dudas.'
          )}
          target="_blank"
          rel="noopener"
          class="rounded-lg border border-white/25 px-7 py-4 font-semibold transition hover:bg-white/10"
        >
          Hablar con nosotros
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
