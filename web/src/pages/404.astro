---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ruta } from '../config/rutas';
---

<BaseLayout title="Página no encontrada — Carreteras 2000 S.A." path="/404">
  <section class="bg-asfalto-950 py-28 text-white sm:py-36">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
      <p class="text-7xl font-extrabold text-amarillo">404</p>
      <h1 class="titulo-seccion mt-4 text-3xl sm:text-4xl">Esta página no existe</h1>
      <p class="mt-4 text-lg text-asfalto-300">
        Puede que el enlace esté viejo. Volvé al inicio o escribinos y te orientamos.
      </p>
      <a
        href={ruta('/')}
        class="mt-8 inline-block rounded-lg bg-rojo-500 px-7 py-4 font-semibold transition hover:bg-rojo-600"
      >
        Volver al inicio
      </a>
    </div>
  </section>
</BaseLayout>
